# Enforce LF line endings across all platforms (Windows, macOS, Linux)
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Binary files
*.gz binary
*.pdf binary
*.png binary
*.jpg binary
