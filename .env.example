# ==============================================================================
# Environment Configuration Template (Copy to .env)
# ==============================================================================

# PostgreSQL Connection Settings
PG_HOST=localhost
PG_PORT=5432
PG_DB=nasa_analytics
PG_USER=postgres
PG_PASSWORD=postgres

# MongoDB Connection Settings (MONGO_PORT is the host port docker compose publishes)
MONGO_PORT=27017
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=nasa_etl

# Hive Connection Settings (compose profile "hadoop")
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DATABASE=nasa_etl
# Folder on THIS machine where the Hive engine writes each batch as a text file. It is
# mounted into the hive-server container as HIVE_STAGING_MOUNT (see docker-compose.yml);
# HiveQL "LOAD DATA LOCAL INPATH" then copies the file into HDFS. Relative to the repo root.
HIVE_STAGING_DIR=.hive_staging
HIVE_STAGING_MOUNT=/staging

# Local Dataset Directory
DATA_DIR=data
